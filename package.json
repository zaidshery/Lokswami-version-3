{
  "name": "lokswami-v2",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "clean:next": "node scripts/clean-next-artifacts.js .next .next-dev",
    "clean:next:dev": "node scripts/clean-next-artifacts.js .next-dev",
    "clean:next:prod": "node scripts/clean-next-artifacts.js .next",
    "prepare:next:dev": "node scripts/sync-next-env-dist.js .next-dev",
    "prepare:next:prod": "node scripts/sync-next-env-dist.js .next",
    "prebuild": "npm run prepare:next:prod && npm run clean:next:prod",
    "dev": "node scripts/start-next-dev.js",
    "build:ci": "npm run prebuild && npm run build:next",
    "build:vercel": "npm run build:ci",
    "build": "npm run build:next && node scripts/prepare-hostinger.js",
    "build:hostinger": "npm run build",
    "build:next": "next build",
    "package:hostinger-upload": "node scripts/create-upload-zip.js",
    "rollback:hostinger": "node scripts/rollback-hostinger-release.js",
    "start": "node scripts/start-hostinger.js",
    "start:hostinger": "npm run start",
    "start:next": "next start",
    "test": "vitest run",
    "test:ci": "npm test && npm run test:auth-guards && npm run test:admin-credentials",
    "test:security": "vitest run tests/security-rate-limiter.test.ts tests/security-validation.test.ts tests/security-audit-logger.test.ts tests/security-request-logger.test.ts tests/security-csp-report.test.ts tests/security-request-log-reader.test.ts tests/api/admin-team-routes.test.ts tests/tts-queue.test.ts",
    "test:e2e": "npx playwright test",
    "test:browser-smoke": "node scripts/browser-smoke-local.js",
    "docs:cms-sop-pdf": "node scripts/generate-cms-sop-pdf.js",
    "quality:full": "npm run typecheck && npm run lint:strict && npm run test:security && npm run test:governance && npm run test:four-role-newsroom && npm run build:ci",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint app/api/admin lib/api lib/auth lib/db lib/models lib/security lib/server lib/storage --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:auth-guards": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/test-auth-guards.ts",
    "test:admin-credentials": "ts-node --files --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/test-admin-credentials.ts",
    "test:admin-runtime": "node scripts/test-admin-runtime.js",
    "test:governance": "npm run typecheck && vitest run tests/deployment-safeguards.test.ts tests/permissions-governance.test.ts tests/permission-review.test.ts tests/operational-diagnostics.test.ts",
    "test:four-role-newsroom": "npm run typecheck && vitest run tests/api/admin-team-routes.test.ts tests/api/admin-team-setup-link-route.test.ts tests/api/staff-setup-route.test.ts tests/permissions-governance.test.ts tests/newsroom-workflow-transitions.test.ts tests/newsroom-metadata.test.ts",
    "test:gemini-tts": "ts-node --files --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/test-gemini-tts.ts",
    "test:spaces": "node scripts/test-digitalocean-spaces.js",
    "test:smoke": "node scripts/smoke-check-deploy.js",
    "test:seo-smoke": "node scripts/seo-smoke-check.js",
    "audit:seo-indexing": "ts-node --files --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/audit-seo-indexing.ts",
    "audit:seo-health": "node scripts/seo-health-audit.js",
    "audit:structure": "node scripts/audit-project-structure.js",
    "capture:baseline": "node scripts/capture-improvement-baseline.js",
    "load:test:public": "node scripts/load-test-public.js",
    "verify:prod-env": "node scripts/validate-production-env.js",
    "verify:dependency-security": "node scripts/validate-dependency-security.js",
    "verify:deploy": "node scripts/verify-deploy.js",
    "seed": "node scripts/seed.js",
    "demo:seed": "ts-node -r tsconfig-paths/register --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"baseUrl\\\":\\\".\\\"}\" scripts/demo/seed.ts",
    "demo:verify": "ts-node -r tsconfig-paths/register --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"baseUrl\\\":\\\".\\\"}\" scripts/demo/verify.ts",
    "demo:reset": "ts-node -r tsconfig-paths/register --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"baseUrl\\\":\\\".\\\"}\" scripts/demo/reset.ts",
    "content:snapshot:pull": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/content-snapshot/pull.ts",
    "content:snapshot:inspect": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/content-snapshot/inspect.ts",
    "content:snapshot:refresh": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/content-snapshot/pull.ts",
    "cms:qa:provision": "ts-node -r tsconfig-paths/register --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"baseUrl\\\":\\\".\\\"}\" scripts/cms-qa/provision.ts",
    "hash-password": "ts-node --files scripts/hash-password.ts",
    "migrate:epapers": "ts-node scripts/migrate-epapers-to-v2.ts",
    "migrate:epaper-workflow-v3": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/migrate-epaper-workflow-v3.ts",
    "migrate:epaper-workflow-v3:write": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/migrate-epaper-workflow-v3.ts --write",
    "migrate:epaper-workflow-v3:indexes": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/migrate-epaper-workflow-v3.ts --indexes-only",
    "migrate:swipe-videos": "ts-node -r tsconfig-paths/register --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"baseUrl\\\":\\\".\\\"}\" scripts/migrate-swipe-videos.ts",
    "migrate:swipe-videos:write": "ts-node -r tsconfig-paths/register --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"baseUrl\\\":\\\".\\\"}\" scripts/migrate-swipe-videos.ts --write",
    "migrate:four-role-admin": "node scripts/migrate-four-role-admin.js",
    "migrate:four-role-admin:write": "node scripts/migrate-four-role-admin.js --write"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@floating-ui/dom": "^1.8.0",
    "@napi-rs/canvas": "^1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "autoprefixer": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.22",
    "framer-motion": "^11.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.1",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-swipeable": "^7.0.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "tesseract.js": "7.0.0",
    "typescript": "^5.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.0",
    "vitest": "^4.1.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "picomatch@2.3.1": "2.3.2",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
