# MongoDB
MONGODB_URI=mongodb+srv://your_username:your_password@cluster-name.mongodb.net/lokswami?retryWrites=true&w=majority
# Public feed guardrails. Keep bounded so E-paper/E-magazine pages do not hang on DB stalls.
MONGODB_PUBLIC_PROBE_TIMEOUT_MS=3000
MONGODB_PUBLIC_QUERY_TIMEOUT_MS=2000

# NextAuth + Google OAuth
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google analytics. Preferred production setup: place the GA4 Google tag inside
# the GTM container so only one loader is shipped. The GA4 ID is a direct-mode
# fallback and is loaded only when NEXT_PUBLIC_GTM_ID is empty.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
LEADERSHIP_REPORT_FROM_EMAIL=
LEADERSHIP_REPORT_CRON_SECRET=
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ADMIN_EMAILS=admin@example.com

# DigitalOcean Spaces media storage
# Create a Standard Spaces bucket, enable CDN, then create a limited access key
# with Read/Write/Delete permission for that bucket.
DIGITALOCEAN_SPACES_ACCESS_KEY=
DIGITALOCEAN_SPACES_SECRET_KEY=
DIGITALOCEAN_SPACES_BUCKET=
DIGITALOCEAN_SPACES_REGION=sgp1
DIGITALOCEAN_SPACES_CDN_BASE_URL=https://your-bucket.sgp1.cdn.digitaloceanspaces.com
# Comma-separated browser origins allowed by the Spaces bucket CORS rules.
DIGITALOCEAN_SPACES_CORS_ORIGINS=http://localhost:3000,https://lokswami.com

# Optional legacy secret aliases still supported by middleware/auth helpers
JWT_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-long-random-secret

# Optional OCR integrations
# Default is local/manual OCR only. Do not set paid AI API keys here.
OCR_SPACE_LANGUAGE=hin
OCR_CUSTOM_API_URL=
OCR_CUSTOM_API_KEY=
NEXT_PUBLIC_EPAPER_LOCAL_OCR_ONLY=true
NEXT_PUBLIC_EPAPER_REMOTE_OCR_FALLBACK=false


# Optional extra remote image hosts for next/image
NEXT_IMAGE_ALLOWED_HOSTS=

# Optional writable uploads base dir for e-paper assets
EPAPER_STORAGE_UPLOADS_BASE_DIR=storage/uploads

# Background e-paper processing
# Set to 0 to pause new worker claims. Optionally restrict processing to a
# comma-separated city slug allowlist during rollout.
EPAPER_BACKGROUND_PROCESSING_ENABLED=1
EPAPER_BACKGROUND_PROCESSING_CITY_ALLOWLIST=
# Enable only after the single-edition hosting capacity pilot passes.
# Local Hindi/English assets are bundled. No external OCR service is used.
EPAPER_LOCAL_OCR_ENABLED=0
EPAPER_LOCAL_OCR_CITY_ALLOWLIST=
EPAPER_STUCK_WARNING_HOURS=6
ADMIN_CRON_SECRET=replace-with-a-long-random-secret

# Optional AI avatar image (external URL or absolute path). Example:
# NEXT_PUBLIC_AI_AVATAR_URL=https://cdn.example.com/lokswami-ai-female.png
# NEXT_PUBLIC_AI_AVATAR_URL=/ai/female-ai-bot.png
NEXT_PUBLIC_AI_AVATAR_URL=

# Optional evidence-bound Hindi/English article translation assistant.
# Article text is sent only after an authenticated editor explicitly requests a translation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Upstash Redis distributed rate limiting and distributed locks
# When omitted, the system seamlessly falls back to in-memory rate limiting and in-process mutex queues.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
