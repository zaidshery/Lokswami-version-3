# LokSwami B3 — Phase 3.4 staging / preview environment template
#
# SAFETY RULES
# - Never copy production secrets into this file or a staging environment.
# - Never point staging at the production MongoDB database or media bucket.
# - Keep outbound integrations disabled during Phase 3.4.
# - Use real secret values only in the deployment provider's encrypted environment settings.

LOKSWAMI_ENV=staging

# -----------------------------------------------------------------------------
# Staging application origin
# Use one stable NON-PRODUCTION HTTPS origin for CMS/auth testing.
# Do not use https://lokswami.com or https://www.lokswami.com.
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://lokswami-staging.example.com
NEXT_PUBLIC_SITE_URL=https://lokswami-staging.example.com

# -----------------------------------------------------------------------------
# Dedicated staging database
# Database name MUST visibly contain staging / preview / test.
# Example only — replace through encrypted deployment environment settings.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://staging_user:replace-me@staging-cluster.example.mongodb.net/lokswami_staging?retryWrites=true&w=majority
MONGODB_PUBLIC_PROBE_TIMEOUT_MS=3000
MONGODB_PUBLIC_QUERY_TIMEOUT_MS=2000

# -----------------------------------------------------------------------------
# Staging-only auth/session secrets
# Generate unique values. Never reuse production secrets.
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=replace-with-a-unique-staging-secret-at-least-32-characters
JWT_SECRET=replace-with-a-unique-staging-jwt-secret-at-least-32-characters

# Optional bootstrap/admin credentials. Use staging-only identities.
ADMIN_LOGIN_ID=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# Google OAuth — optional
# Use a dedicated OAuth client or explicitly registered staging callback/origin.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Dedicated staging media storage
# Bucket name must visibly identify staging / preview / test.
# -----------------------------------------------------------------------------
DIGITALOCEAN_SPACES_ACCESS_KEY=
DIGITALOCEAN_SPACES_SECRET_KEY=
DIGITALOCEAN_SPACES_BUCKET=lokswami-staging
DIGITALOCEAN_SPACES_REGION=sgp1
DIGITALOCEAN_SPACES_CDN_BASE_URL=
DIGITALOCEAN_SPACES_CORS_ORIGINS=http://localhost:3000,https://lokswami-staging.example.com

# Keep generated E-paper files out of immutable/public deploy output.
EPAPER_STORAGE_UPLOADS_BASE_DIR=storage/uploads
EPAPER_FORCE_STORAGE=1

# -----------------------------------------------------------------------------
# OUTBOUND SAFETY — intentionally disabled for Phase 3.4
# -----------------------------------------------------------------------------
# Social automation must remain manual. Do not configure n8n/generic webhooks.
SOCIAL_AUTOMATION_PROVIDER=manual
SOCIAL_AUTOMATION_WEBHOOK_URL=
N8N_SOCIAL_WEBHOOK_URL=
SOCIAL_AUTOMATION_SHARED_SECRET=
SOCIAL_AUTOMATION_TIMEOUT_MS=15000

# Email delivery must remain disabled. Empty Resend key causes email helpers to skip.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_ACK_FROM_EMAIL=
LEADERSHIP_REPORT_FROM_EMAIL=

# Scheduled/cron outbound work intentionally disabled during Phase 3.4.
LEADERSHIP_REPORT_CRON_SECRET=
ADMIN_CRON_SECRET=
CRON_SECRET=

# Do not copy production leadership webhook schedules into the staging database.

# -----------------------------------------------------------------------------
# Analytics — keep production analytics isolated
# Configure only after a dedicated staging GTM/property is approved.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=

# -----------------------------------------------------------------------------
# AI / OCR — local/manual by default
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OCR_SPACE_LANGUAGE=hin
OCR_CUSTOM_API_URL=
OCR_CUSTOM_API_KEY=
NEXT_PUBLIC_EPAPER_LOCAL_OCR_ONLY=true
NEXT_PUBLIC_EPAPER_REMOTE_OCR_FALLBACK=false

# -----------------------------------------------------------------------------
# Optional image hosts / caches
# Do not add production-only hosts or shared production infrastructure casually.
# -----------------------------------------------------------------------------
NEXT_IMAGE_ALLOWED_HOSTS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
